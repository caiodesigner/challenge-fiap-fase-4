{
  "protocol_version": "functional-v1",
  "scope": "synthetic_functional_fixtures_only",
  "development_split": "development",
  "calibration_split": "validation",
  "reporting_split": "test",
  "independence_limit": "Shared generation templates; not an independent clinical test",
  "comparisons": ["baseline_vs_temporal", "isolated_vs_fusion"],
  "event_matching": {
    "keys": ["patient_id", "session_id", "event_type"],
    "strategy": "one_to_one_nearest_onset",
    "onset_tolerance_seconds": 5,
    "tie_breaker": "event_id_lexicographic",
    "extra_predictions": "false_positive",
    "unmatched_references": "false_negative",
    "text_and_prescription": "source_record_or_mention_id"
  },
  "fusion_window_seconds": 30,
  "reordering_buffer_seconds": 5,
  "metrics": ["precision", "recall", "f1", "false_alerts_per_hour", "latency_p95", "wer"],
  "empty_denominator_policy": "report_null_with_counts",
  "experimental_targets": {
    "precision": 0.8,
    "recall": 0.8,
    "critical_term_recall": 0.9,
    "local_latency_p95_seconds": 5,
    "azure_latency_p95_seconds": 30
  },
  "no_clinical_performance_claim": true
}
